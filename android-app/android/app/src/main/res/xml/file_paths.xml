<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Directory.Data de @capacitor/filesystem (donde guardarArchivoNativo()
         en scanner.html escribe el PDF/Excel antes de compartirlo) es la
         carpeta "files" propia de la app: sin esta entrada, FileProvider
         no encuentra una raiz configurada para esa carpeta y
         getUriForFile() tira IllegalArgumentException. El share/guardado
         del PDF fallaba en silencio (atrapado por el try/catch de
         guardarArchivoNativo), nunca llegaba a mostrarse el cuadro de
         compartir de verdad. -->
    <files-path name="my_files" path="." />
</paths>